{% extends "_includes/layouts/base.njk" %}

{% block extraCSS %}
<style>
  /* ====== Homepage-specific: front-card gradient backgrounds ====== */
  .front-which    { background: linear-gradient(135deg, #6ba9bd, #3c7389 50%, #274455); }
  .front-routes   { background: linear-gradient(135deg, #efbf77, #d28a40 50%, #92522a); }
  .front-tuning   { background: linear-gradient(135deg, #d78872, #b15d51 50%, #743934); }
  .front-community{ background: linear-gradient(135deg, #8ab79b, #5e9274 50%, #345945); }
  .front-clawwatch{ background: linear-gradient(135deg, #7ec8d6, #3e8e9f 50%, #225a6e); }

  /* ====== Summary band (homepage only) ====== */
  .summary-band {
    margin: 1.1rem 0 0; padding: 1rem 1.1rem; border-radius: 16px;
    background: linear-gradient(135deg, rgba(244, 201, 107, 0.16), rgba(93, 143, 163, 0.08));
    border: 1px solid rgba(216, 121, 89, 0.12);
  }
  html.dark .summary-band {
    background: rgba(93,143,163,0.1);
    border-color: rgba(93,143,163,0.2);
    color: #e8ebe8;
  }
  html.dark .summary-band strong { color: #e8ebe8; }
  html.dark .summary-band a { color: #8ab4c7; }
  html.dark .summary-band a:hover { color: #d87959; }

  /* ====== Front illustration (homepage) ====== */
  .front-illustration {
    position: relative; z-index: 2; margin-top: 1rem;
    border-radius: 16px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.08);
    min-height: 150px; display: flex; align-items: flex-end; justify-content: center;
  }
  .art-jaunty svg { width: 74%; transform: rotate(-6deg) translateY(10px); transform-origin: center bottom; }

  /* ====== Image generation note ====== */
  .img-note {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    background: rgba(93,143,163,0.08);
    border: 1px solid rgba(93,143,163,0.15);
    font-size: 0.85rem;
    color: #5e9274;
    line-height: 1.5;
  }
  .img-note code {
    background: rgba(93,143,163,0.12);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.82rem;
    font-family: "SF Mono", "Fira Code", monospace;
  }
  html.dark .img-note {
    background: rgba(93,143,163,0.1);
    border-color: rgba(93,143,163,0.2);
    color: #8abd9e;
  }
  html.dark .img-note code {
    background: rgba(93,143,163,0.18);
  }
</style>
{% endblock %}

